{
  "expo": {
    "name": "Easy Farm",
    "slug": "easy-farm-mobile",
    "scheme": "easyfarm",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#065f46"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.easyfarm.customer"
    },
    "android": {
      "package": "com.easyfarm.customer",
      "adaptiveIcon": {
        "backgroundColor": "#065f46",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      [
        "@maplibre/maplibre-react-native",
        {
          "camera": {
            "maxPitch": 85
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Easy Farm needs your location to deliver farm-fresh vegetables to your doorstep."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "2571ef6a-8846-4627-add9-21553c32e1b8"
      }
    },
    "owner": "sravanpachimadla"
  }
}
